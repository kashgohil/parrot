{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Parrot",
	"version": "0.1.0",
	"identifier": "com.kash.parrot",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Parrot",
				"width": 1100,
				"height": 750,
				"minWidth": 800,
				"minHeight": 600,
				"visible": true,
				"decorations": true,
				"hiddenTitle": true,
				"titleBarStyle": "Overlay"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"minimumSystemVersion": "10.15"
		}
	},
	"plugins": {
		"updater": {
			"endpoints": [
				"https://github.com/kashgohil/parrot/releases/latest/download/latest.json"
			],
			"pubkey": "",
			"windows": {
				"installMode": "passive"
			}
		}
	}
}

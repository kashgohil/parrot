{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Parrot",
	"version": "0.2.5",
	"identifier": "com.kash.parrot",
	"build": {
		"beforeDevCommand": "bun run build:sidecar:dev && bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build:sidecar && bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Parrot",
				"width": 1100,
				"height": 750,
				"minWidth": 800,
				"minHeight": 600,
				"visible": true,
				"decorations": true,
				"hiddenTitle": true,
				"titleBarStyle": "Overlay"
			}
		],
		"security": {
			"csp": null
		},
		"macOSPrivateApi": true
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"externalBin": [
			"binaries/cleanup-sidecar"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"minimumSystemVersion": "10.15",
			"signingIdentity": "Developer ID Application: Kashyap Gohil (Z85YN38RUU)",
			"entitlements": "entitlements.plist"
		}
	},
	"plugins": {
		"updater": {
			"endpoints": [
				"https://github.com/kashgohil/parrot/releases/latest/download/latest.json"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFMjE5RkFEMTM4QTkxRTQKUldUa2tZb1RyWjhoL2pMMGgxUkhLZHlLV2l1REJGSTVzTU9JYVN6Y2dJcXFtbHdQbnNWU2Ntam4K",
			"windows": {
				"installMode": "passive"
			}
		}
	}
}

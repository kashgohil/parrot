# Desktop-only env. Loaded by `bun run desktop ...` (which wraps `tauri`
# with `--env-file=.env`). Run all desktop dev/build commands from this
# directory, not the repo root.
#
# Tauri updater signing keys — required for builds that produce updater
# artifacts. Generate with: `bun run tauri signer generate`
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "bun install",
	"buildCommand": "bun run build",
	"git": {
		"deploymentEnabled": false
	},
	"redirects": [
		{
			"source": "/:path*",
			"has": [{ "type": "host", "value": "www.tryparrot.app" }],
			"destination": "https://tryparrot.app/:path*",
			"permanent": true
		}
	]
}

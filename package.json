{
  "name": "parrot",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:desktop": "bun run scripts/dev.ts -- --desktop-only",
    "dev:hero": "bun run --filter hero dev",
    "dev:all": "bun run scripts/dev.ts -- --with-hero",
    "build:hero": "bun run --filter hero build",
    "generate-seo": "bun run --filter hero generate-seo",
    "db:clean": "rm -f ~/Library/Application\\ Support/com.kash.parrot/parrot.db && echo 'Desktop database cleaned. Start the app to create a fresh database.'"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@tauri-apps/cli": "^2"
  }
}
